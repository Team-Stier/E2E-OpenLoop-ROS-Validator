        {"key": "camera_main", "topic": "/image/sparsedrive_v2/front", "ros_type": "sensor_msgs/Image", "preprocess_contract": "cam_f0 using the same 256x512 RGB/normalization contract."},
        {"key": "camera_right", "topic": "/image/sparsedrive_v2/right", "ros_type": "sensor_msgs/Image", "preprocess_contract": "cam_r0 using the same 256x512 RGB/normalization contract."},
        {"key": "driving_feature", "topic": "/driving_feature", "ros_type": "validator_msgs/DrivingFeature", "preprocess_contract": "status_feature = driving_command[4] + ego_velocity[2] + ego_acceleration[2], plus camera_calibrations. OptFeeder loads calibration at startup; selected-model preprocessing applies the same resize/crop matrix to lidar2img before forward."}
      ],
      "output": {"coordinate_frame": "NAVSIM ego-relative SE2", "ros_frame_id": "Lidar3D-4", "coordinate_conversion": "x_ros=x_navsim, y_ros=y_navsim before static base-to-lidar transform", "waypoint_count": 8, "time_horizon_s": 4.0, "interval_s": 0.5},
      "readiness": {"state": "blocked_until_inline_camera_calibration_is_complete", "blocking_inputs": ["static_runtime_inputs.camera_calibration"], "never_skip_for_stale": true},
