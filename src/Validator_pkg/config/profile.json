        {"role": "path_vocabulary", "path": "models/sparsedrive_v2/navsim_v2/path_1024.npy", "source_path": "path_1024.npy", "sha256": "97ff2e843c264fa15a38a6a3920985fd4bdb8f387ef409b2a97d44eb5c88f9c1"},
        {"role": "velocity_vocabulary", "path": "models/sparsedrive_v2/navsim_v2/velocity_256.npy", "source_path": "velocity_256.npy", "sha256": "acfaa8699401a20283c2744f7ea4beb4f8c734f3a3f145ca0366a3ba6abae2ee"},
        {"role": "trajectory_vocabulary", "path": "models/sparsedrive_v2/navsim_v2/trajectory_1024_256.npz", "source_path": "trajectory_1024_256.npz", "sha256": "94868f922fcd7ac3a027057476ddf630948c908053fec483d8936e84b2ad8683"}
      ],
      "static_runtime_inputs": {"camera_calibration": {"source": "profile_inline", "lidar_frame_id": "Lidar3D-4", "projection_contract": "For each camera fill K_original_3x3, distortion_model, distortion_coefficients, and T_lidar_from_camera_4x4. At runtime compute T_camera_from_lidar = inverse(T_lidar_from_camera), then lidar2img = A_resize_crop * K_original * T_camera_from_lidar[:3,:]. Distortion is removed according to the supplied model before the resize/crop image transform.", "cameras": [{"name": "front", "frame_id": "Camera-1", "image_size_px": [1280, 720], "K_original_3x3": null, "distortion_model": null, "distortion_coefficients": null, "T_lidar_from_camera_4x4": null}, {"name": "left", "frame_id": "Camera-2", "image_size_px": [640, 480], "K_original_3x3": null, "distortion_model": null, "distortion_coefficients": null, "T_lidar_from_camera_4x4": null}, {"name": "right", "frame_id": "Camera-3", "image_size_px": [640, 480], "K_original_3x3": null, "distortion_model": null, "distortion_coefficients": null, "T_lidar_from_camera_4x4": null}]}},
      "buffer_requirements": {"latest_inputs": ["camera_left", "camera_main", "camera_right", "driving_feature"], "history_inputs": []},
      "required_inputs": [
