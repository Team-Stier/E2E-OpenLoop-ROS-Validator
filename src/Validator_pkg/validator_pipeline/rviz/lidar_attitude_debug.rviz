Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 100; 100; 100
      Enabled: true
      Name: base_link z=0 Grid
      Plane: XY
      Reference Frame: base_link
      Value: true
    - Class: rviz/PointCloud2
      Color Transformer: RGB8
      Enabled: true
      Name: z=0 Colored Points
      Position Transformer: XYZ
      Queue Size: 2
      Size (Pixels): 3
      Style: Points
      Topic: /lidar/debug/colored_points
      Unreliable: false
      Value: true
    - Alpha: 1
      Class: rviz/PointCloud2
      Color: 0; 255; 0
      Color Transformer: FlatColor
      Enabled: true
      Name: Road-Leveled Points
      Position Transformer: XYZ
      Queue Size: 2
      Size (Pixels): 3
      Style: Points
      Topic: /lidar3D/leveled
      Unreliable: false
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /lidar/debug/markers
      Name: Attitude Planes and Normals
      Namespaces:
        lidar_attitude_debug: true
      Queue Size: 10
      Value: true
    - Class: rviz/Image
      Enabled: true
      Image Topic: /lidar/debug/ground_bev
      Name: z=0 Ground BEV
      Normalize Range: true
      Queue Size: 2
      Transport Hint: raw
      Unreliable: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Default Light: true
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 30
      Focal Point:
        X: 10
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.75
      Target Frame: base_link
      Yaw: 3.14
Window Geometry:
  Height: 900
  Width: 1400
