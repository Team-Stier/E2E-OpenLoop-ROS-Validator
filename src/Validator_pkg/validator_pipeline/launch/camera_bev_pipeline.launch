<launch>
  <arg name="config_path" default="$(find Validator_pkg)/config/0725demo_ros.json" />
  <arg name="model_profiles" default="raw" />
  <arg name="use_ros_time_stamp" default="false" />
  <arg name="morai_ddv2_domain" default="true" />
  <arg name="show_gui" default="true" />
  <arg name="forward_range" default="25.0" />
  <arg name="lateral_range" default="30.0" />
  <arg name="resolution" default="0.05" />
  <arg name="publish_debug_bevs" default="true" />
  <arg name="enable_bev_overlay" default="false" />
  <arg name="overlay_sync_slop" default="0.20" />
  <arg name="overlay_lidar_alpha" default="0.70" />

  <node
    pkg="Validator_pkg"
    type="image_adaptor.py"
    name="image_adaptor"
    output="screen"
    required="true"
  >
    <param name="config_path" value="$(arg config_path)" />
    <param name="model_profiles" value="$(arg model_profiles)" />
    <param name="use_ros_time_stamp" value="$(arg use_ros_time_stamp)" />
    <param name="morai_ddv2_domain" value="$(arg morai_ddv2_domain)" />
  </node>

  <node
    pkg="Validator_pkg"
    type="lidar_bev_processor.py"
    name="lidar_bev_processor"
    output="screen"
    required="true"
  >
    <param name="config_path" value="$(arg config_path)" />
    <param name="model_profiles" value="$(arg model_profiles)" />
    <param name="use_ros_time_stamp" value="$(arg use_ros_time_stamp)" />
    <param name="morai_ddv2_domain" value="$(arg morai_ddv2_domain)" />
    <param name="show_gui" value="$(arg show_gui)" />
    <param name="forward_range" value="$(arg forward_range)" />
    <param name="lateral_range" value="$(arg lateral_range)" />
    <param name="resolution" value="$(arg resolution)" />
  </node>

  <node
    pkg="Validator_pkg"
    type="camera_bev_stitcher.py"
    name="camera_bev_stitcher"
    output="screen"
    required="true"
  >
    <param name="config_path" value="$(arg config_path)" />
    <param name="show_gui" value="$(arg show_gui)" />
    <param name="forward_range" value="$(arg forward_range)" />
    <param name="lateral_range" value="$(arg lateral_range)" />
    <param name="resolution" value="$(arg resolution)" />
    <param name="publish_debug_bevs" value="$(arg publish_debug_bevs)" />
  </node>

  <node
    if="$(arg enable_bev_overlay)"
    pkg="Validator_pkg"
    type="bev_overlay_viewer.py"
    name="bev_overlay_viewer"
    output="screen"
  >
    <param name="sync_slop" value="$(arg overlay_sync_slop)" />
    <param name="lidar_alpha" value="$(arg overlay_lidar_alpha)" />
  </node>
</launch>
