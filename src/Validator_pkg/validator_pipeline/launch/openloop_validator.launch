<launch>
  <arg name="model_id" default="interfuser"/>
  <arg name="profile_file" default=""/>
  <arg name="record_dir" default="$(find validator_inference)/../../../records/openloop"/>
  <arg name="sensor_config" default="$(find Validator_pkg)/config/0716demo.json"/>

  <arg name="show_gui" default="false"/>
  <arg name="show_rviz" default="false"/>
  <arg name="draw_waypoints" default="true"/>
  <arg name="enable_bev_overlay_qa" default="false"/>

  <arg name="forward_range" default="25.0"/>
  <arg name="lateral_range" default="30.0"/>
  <arg name="resolution" default="0.05"/>

  <include file="$(find Validator_pkg)/launch/camera_bev_pipeline.launch">
    <arg name="config_path" value="$(arg sensor_config)"/>
    <arg name="model_profiles" value="$(arg model_id)"/>
    <arg name="show_gui" value="$(arg show_gui)"/>
    <arg name="forward_range" value="$(arg forward_range)"/>
    <arg name="lateral_range" value="$(arg lateral_range)"/>
    <arg name="resolution" value="$(arg resolution)"/>
    <arg name="enable_bev_overlay" value="$(arg enable_bev_overlay_qa)"/>
  </include>

  <include file="$(find validator_inference)/launch/openloop_inference.launch">
    <arg name="model_id" value="$(arg model_id)"/>
    <arg name="profile_file" value="$(arg profile_file)"/>
    <arg name="record_dir" value="$(arg record_dir)"/>
  </include>

  <include file="$(find Validator_pkg)/launch/bev_visualization.launch">
    <arg name="show_rviz" value="$(arg show_rviz)"/>
    <arg name="draw_waypoints" value="$(arg draw_waypoints)"/>
    <arg name="profile_file" value="$(arg profile_file)"/>
    <arg name="forward_range" value="$(arg forward_range)"/>
    <arg name="lateral_range" value="$(arg lateral_range)"/>
    <arg name="resolution" value="$(arg resolution)"/>
  </include>
</launch>
