<launch>
  <arg name="config_path" default="$(find Validator_pkg)/config/0716demo.json" />
  <arg name="model_profiles" default="raw" />
  <arg name="show_gui" default="true" />
  <arg name="forward_range" default="25.0" />
  <arg name="lateral_range" default="30.0" />
  <arg name="resolution" default="0.05" />
  <arg name="publish_debug_bevs" default="true" />

  <node
    pkg="Validator_pkg"
    type="image_adaptor.py"
    name="image_adaptor"
    output="screen"
  >
    <param name="model_profiles" value="$(arg model_profiles)" />
  </node>

  <node
    pkg="Validator_pkg"
    type="lidar_bev_processor.py"
    name="lidar_bev_processor"
    output="screen"
  >
    <param name="config_path" value="$(arg config_path)" />
    <param name="model_profiles" value="$(arg model_profiles)" />
    <param name="show_gui" value="$(arg show_gui)" />
  </node>

  <node
    pkg="Validator_pkg"
    type="camera_bev_stitcher.py"
    name="camera_bev_stitcher"
    output="screen"
  >
    <param name="config_path" value="$(arg config_path)" />
    <param name="show_gui" value="$(arg show_gui)" />
    <param name="forward_range" value="$(arg forward_range)" />
    <param name="lateral_range" value="$(arg lateral_range)" />
    <param name="resolution" value="$(arg resolution)" />
    <param name="publish_debug_bevs" value="$(arg publish_debug_bevs)" />
  </node>
</launch>
