<launch>
  <arg name="model_id" default="interfuser"/>
  <arg name="project_root" default="$(eval '/'.join(find('validator_inference').split('/')[:-3]))"/>
  <arg name="model_env_root" default="$(arg project_root)/.venvs"/>
  <!-- Empty means: let each node resolve the source/install profile location. -->
  <arg name="profile_file" default=""/>
  <arg name="record_dir" default="$(arg project_root)/records/openloop"/>
  <arg name="use_ros_time_stamp" default="false"/>
  <arg name="command_sidecar" default=""/>

  <param name="/use_sim_time" value="true"/>

  <node pkg="validator_inference" type="opt_feeder_node.py" name="opt_feeder" output="screen" required="true">
    <param name="model_id" value="$(arg model_id)"/>
    <param if="$(eval arg('profile_file') != '')" name="profile_file" value="$(arg profile_file)"/>
    <param name="use_ros_time_stamp" value="$(arg use_ros_time_stamp)"/>
    <param if="$(eval arg('command_sidecar') != '')" name="command_sidecar" value="$(arg command_sidecar)"/>
  </node>

  <node pkg="validator_inference" type="inference_engine_node.py" name="inference_engine" output="screen" required="true" launch-prefix="&quot;$(find validator_inference)/scripts/model_env_exec&quot;">
    <env name="OPENLOOP_MODEL_ENV_ROOT" value="$(arg model_env_root)"/>
    <env name="OPENLOOP_MODEL_ID" value="$(arg model_id)"/>
    <env name="OPENLOOP_PROJECT_ROOT" value="$(arg project_root)"/>
    <param name="model_id" value="$(arg model_id)"/>
    <param if="$(eval arg('profile_file') != '')" name="profile_file" value="$(arg profile_file)"/>
  </node>

  <node pkg="validator_inference" type="recorder_node.py" name="recorder" output="screen" required="true">
    <param name="model_id" value="$(arg model_id)"/>
    <param name="record_dir" value="$(arg record_dir)"/>
  </node>
</launch>
